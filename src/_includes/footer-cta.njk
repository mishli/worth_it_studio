<div class="container fluid cta cta-footer">
    <section class="content-section hero center">
        <h2>{{ "footer_cta_heading" | i18n({}, locale) }}</h2>
        <p>{{ "footer_cta_paragraph" | i18n({}, locale) }}</p>

        <div class="btn btn-main large pulse">
            <button class="whatsapp-button" aria-label="{{ "nav_whatsapp_aria" | i18n({}, locale) }}" onclick="openWhatsApp()">
                {% include 'icon-whatsapp.njk' %}
                {{ "footer_cta_whatsapp_button" | i18n({}, locale) }}
            </button>
        </div>
    </section>   
</div>